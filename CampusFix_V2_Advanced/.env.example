# Copy these values into your environment before deployment. Never commit real secrets.
SECRET_KEY=replace-with-a-long-random-secret
# Configure SMTP to enable email verification, password reset, and notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM=CampusFix <no-reply@example.com>
# Set to 1 only when serving over HTTPS
COOKIE_SECURE=1
FLASK_DEBUG=0
